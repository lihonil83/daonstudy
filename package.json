{
  "name": "daonstudy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:smoke": "vite build --mode smoke",
    "preview": "vite preview",
    "smoke:browser": "npm run build:smoke && node scripts/browser-smoke.mjs",
    "smoke:browser:prod": "npm run build && node scripts/browser-smoke.mjs --production",
    "release:prep": "node scripts/release-prep.mjs",
    "check": "npm run test && npm run validate:docs && npm run build",
    "test": "node --test",
    "validate:docs": "node scripts/validate-docs.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "vite": "^5.4.10"
  }
}
